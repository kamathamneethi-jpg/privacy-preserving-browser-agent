# Privacy-Preserving Lightweight Browser Agent Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN RUNTIME VALUES
# DO NOT COMMIT THE .env FILE OR REAL CREDENTIALS TO VERSION CONTROL

# Remote Reasoning Backend Service Endpoint (Must use HTTPS in production mode)
REASONING_BACKEND_URL=

# Runtime Authentication Key / Bearer Token (Injected dynamically; never hardcoded)
REASONING_API_KEY=

# OpenRouter LLM Provider Configuration
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Groq Cloud LLM Provider Configuration (Ultra-fast inference e.g. openai/gpt-oss-20b, llama-3.3-70b-versatile)
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-20b

# Local ONNX Runtime / Model Options (Optional)
ONNX_MODEL_PATH=

# Transport Execution Mode (MOCK_TEST_TRANSPORT | OPENROUTER_TRANSPORT | GROQ_TRANSPORT | REAL_REMOTE_TRANSPORT)
SECURE_TRANSPORT_MODE=GROQ_TRANSPORT

