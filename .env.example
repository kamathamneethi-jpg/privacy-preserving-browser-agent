# Privacy-Preserving Lightweight Browser Agent Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN RUNTIME VALUES
# DO NOT COMMIT THE .env FILE OR REAL CREDENTIALS TO VERSION CONTROL

# =========================================================================
# 1. Transport & Backend Configuration
# =========================================================================
# Remote Reasoning Backend Service Endpoint (Must use HTTPS in production mode)
REASONING_BACKEND_URL=https://your-secure-backend-endpoint.invalid/reason

# Runtime Authentication Key / Bearer Token (Injected dynamically; never hardcoded)
REASONING_API_KEY=

# Transport Execution Mode (MOCK_TEST_TRANSPORT | REAL_REMOTE_TRANSPORT)
SECURE_TRANSPORT_MODE=MOCK_TEST_TRANSPORT

# =========================================================================
# 2. Remote LLM Provider API Keys (Used ONLY in services/reasoning-backend)
# =========================================================================
# Selected Provider: gemini | openai | groq | openrouter | huggingface
LLM_PROVIDER=gemini

# Google Gemini API Key (Gemini 2.0 Flash / 1.5 Flash)
GEMINI_API_KEY=

# OpenAI API Key (GPT-4o-mini / GPT-4o)
OPENAI_API_KEY=

# Groq API Key (Llama 3.3 70B / 8B)
GROQ_API_KEY=

# OpenRouter API Key (e.g. Claude 3.5 Sonnet, Llama 3.3 70B, Qwen 2.5)
OPENROUTER_API_KEY=

# Hugging Face User Access Token / API Key (e.g. Serverless Inference API)
HUGGINGFACE_API_KEY=
HF_TOKEN=

# =========================================================================
# 3. Local On-Device Model Options (100% Local - No API Keys Needed)
# =========================================================================
# GLiNER Local Model Path (DOM/Text PII)
GLINER_MODEL_PATH=models/gliner-small

# YOLO Local Model Path (Screenshot/Visual PII)
YOLO_MODEL_PATH=models/yolo-pii

# ONNX Runtime Execution Provider (wasm | webgpu | cpu)
ONNX_EXECUTION_PROVIDER=wasm
