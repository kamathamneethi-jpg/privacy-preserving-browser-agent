# Privacy-Preserving Lightweight Browser Agent Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN RUNTIME VALUES
# DO NOT COMMIT THE .env FILE OR REAL CREDENTIALS TO VERSION CONTROL

# Remote Reasoning Backend Service Endpoint (Must use HTTPS in production mode)
REASONING_BACKEND_URL=

# Runtime Authentication Key / Bearer Token (Injected dynamically; never hardcoded)
REASONING_API_KEY=

# Local ONNX Runtime / Model Options (Optional)
ONNX_MODEL_PATH=

# Transport Execution Mode (MOCK_TEST_TRANSPORT | REAL_REMOTE_TRANSPORT)
SECURE_TRANSPORT_MODE=MOCK_TEST_TRANSPORT
