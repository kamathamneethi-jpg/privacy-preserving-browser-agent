{
  "name": "privacy-preserving-browser-agent",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "privacy-preserving-browser-agent",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@privacy-agent/privacy-core": {
      "resolved": "packages/privacy-core",
      "link": true
    },
    "node_modules/@privacy-agent/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "packages/privacy-core": {
      "name": "@privacy-agent/privacy-core",
      "version": "0.1.0"
    },
    "packages/shared-types": {
      "name": "@privacy-agent/shared-types",
      "version": "0.1.0"
    }
  }
}
